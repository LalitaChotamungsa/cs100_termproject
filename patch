+/* ---------- EXPORT my-portfolio.json ---------- */
+function downloadJsonFile(filename, data) {
+    const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
+    const url = URL.createObjectURL(blob);
+    const link = document.createElement("a");
+    link.href = url;
+    link.download = filename;
+    document.body.appendChild(link);
+    link.click();
+    link.remove();
+    setTimeout(() => URL.revokeObjectURL(url), 1000);
+}
+
+function exportMyPortfolio(portfolio) {
+    const items = portfolio.items || [];
+
+    if (items.length === 0) {
+        alert("This Portfolio has no items yet. Please add at least one item before exporting.");
+        return;
+    }
+
+    const noEvidence = items.filter(
+        (item) => !Array.isArray(item.evidence) || item.evidence.length === 0
+    );
+    if (noEvidence.length > 0) {
+        const goOn = confirm(
+            noEvidence.length + " item(s) have no Evidence yet. Export anyway?"
+        );
+        if (!goOn) return;
+    }
+
+    downloadJsonFile("my-portfolio.json", portfolio);
+}
